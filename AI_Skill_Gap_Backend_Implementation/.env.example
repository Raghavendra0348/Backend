# ──────────────────────────────────────────────────────────────────────────────
# AI Skill Gap Backend — Environment Variables
# Copy this file to .env and fill in your values before running the app.
# NEVER commit your real .env file to version control!
# ──────────────────────────────────────────────────────────────────────────────

# ── Security ─────────────────────────────────────────────────────────────────
# Flask secret key (used for sessions). Use a long random string in production.
SECRET_KEY=change-me-in-production

# JWT signing key (optional — falls back to SECRET_KEY if not set).
# Must be at least 32 characters in production.
JWT_SECRET_KEY=change-me-jwt-secret-min-32-chars

# ── Database ──────────────────────────────────────────────────────────────────
# MySQL connection string. If not set, the app falls back to SQLite (local dev).
# SQLite (zero config, local dev only):
#   DATABASE_URL=sqlite:///skill_gap.db
# MySQL (production / staging):
DATABASE_URL=mysql+pymysql://skill_app:YourPasswordHere@localhost:3306/skill_gap_db

# ── File Storage ──────────────────────────────────────────────────────────────
# Directory where uploaded resumes are saved (relative to app root or absolute).
UPLOAD_DIR=storage/uploads

# Max upload file size in bytes (default 5 MB).
MAX_CONTENT_LENGTH=5242880

# ── ML Model ──────────────────────────────────────────────────────────────────
# Path to the trained skill-gap classification model joblib file.
# Generate with: flask --app app train-model
MODEL_PATH=ml/models/skill_gap_model.joblib

# ── Dataset Paths (required for flask ingest-data) ────────────────────────────
# Path to the ESCO v1.2.1 classification CSV folder.
# Download from: https://esco.ec.europa.eu/en/use-esco/download
ESCO_DATA_DIR=../Dataset/esco/classification_en_csv

# Path to the O*NET data folder (contains Knowledge.xlsx, Work_Activities.xlsx,
# Occupation_Data.xlsx). Download from: https://www.onetcenter.org/database.html
ONET_DATA_DIR=../Dataset/onet
ONET_KNOWLEDGE_XLSX=../Dataset/onet/Knowledge.xlsx
ONET_ACTIVITIES_XLSX=../Dataset/onet/Work_Activities.xlsx
ONET_OCCUPATIONS_XLSX=../Dataset/onet/Occupation_Data.xlsx

# Path to the Coursera.csv file.
# Download from: https://www.kaggle.com/datasets/siddharthm1698/coursera-course-dataset
COURSERA_CSV=../Dataset/coursera/Coursera.csv

# Path to the student profiles Excel file.
STUDENT_DATASET_XLSX=../Dataset/students/Student_Profiles_Indian_Names.xlsx

# ── CORS (Cross-Origin Resource Sharing) ─────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Default allows localhost for local dev; set your production domain here.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
